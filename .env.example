# Ollama Optimizer - example environment file.
# Copy to `.env` (same directory as run.py) and edit. Every value here is a
# default; settings saved from the Settings page override these.

# --- Ollama -----------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_RETRIES=2
# how long Ollama keeps the model resident between requests
OLLAMA_KEEP_ALIVE=5m

# --- This application -------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8848

# --- Benchmark defaults ----------------------------------------------
DEFAULT_RUNS=5
DEFAULT_MAX_TOKENS=512
DEFAULT_TIMEOUT=120
DEFAULT_STREAM=true
# local inference is resource bound; >1 distorts latency measurements
MAX_CONCURRENCY=1
# baseline | generation | prompt | system_prompt | context | runtime | quantization | all
DEFAULT_STRATEGY=all
# quality_first | speed_first | balanced
DEFAULT_OBJECTIVE=balanced
COARSE_FINE_SEARCH=true
AUTO_PDF=true

# --- Evaluation -------------------------------------------------------
# heuristic | heuristic+llm   (LLM scores are always labelled as estimates)
EVALUATOR_MODE=heuristic
# empty = reuse the model being benchmarked
EVALUATOR_MODEL=
EVALUATOR_TIMEOUT=90

# --- Storage / logging ------------------------------------------------
DATABASE_PATH=data/experiments.db
REPORT_DIR=data/reports
LOG_LEVEL=INFO
LOG_FILE=data/app.log
